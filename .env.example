# Скопируйте в .env:  cp .env.example .env
# Сгенерировать секрет:  openssl rand -hex 32

# --- PostgreSQL (используйте простой пароль без @ : / # — он подставляется в URL) ---
POSTGRES_DB=fsp
POSTGRES_USER=fsp
POSTGRES_PASSWORD=change_me_db_password

# --- Backend ---
SECRET_KEY=change_me_long_random_string
TELEGRAM_BOT_TOKEN=

# --- Публичный адрес и порт ---
# Порт, на котором сайт открывается на хосте
HTTP_PORT=8080
# Адрес, который увидят пользователи (попадает в QR-коды сертификатов).
# На сервере: https://fsp56.example.ru
PUBLIC_URL=http://localhost:8080

# --- Фронт ---
# true — показывать демо-аккаунты на странице входа (только для разработки/демо)
SHOW_DEMO=true

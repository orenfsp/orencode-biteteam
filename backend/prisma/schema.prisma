generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  ATHLETE
  COACH
  JUDGE
}
enum CompetitionStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}
enum LinkStatus {
  PENDING
  ACTIVE
  REJECTED
  ENDED
}
enum Outcome {
  FINISHED
  DNS
  DSQ
}
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  fullName String
  birthDate DateTime
  roles Role[] @default([ATHLETE])
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id])
  municipalityId String?
  municipality Directory? @relation("Municipality", fields: [municipalityId], references: [id])
  disciplineIds String[] @default([])
  startYear Int?
  rankId String?
  rank Directory? @relation("Rank", fields: [rankId], references: [id])
  rankExpires DateTime?
  judgeCategoryId String?
  judgeCategory Directory? @relation("JudgeCategory", fields: [judgeCategoryId], references: [id])
  categoryExpires DateTime?
  antidopingDate DateTime?
  antidopingUrl String?
  telegramChatId String? @unique
  createdAt DateTime @default(now())
  consents Consent[]
  sessions Session[]
  coachLinks CoachLink[] @relation("Coach")
  athleteLinks CoachLink[] @relation("Athlete")
  applications Application[]
  assignments Assignment[]
  notifications Notification[]
  audits AuditLog[]
}
model Consent {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  version String
  guardianName String?
  guardianContact String?
  guardianConsent Boolean @default(false)
  acceptedAt DateTime @default(now())
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeRole Role
  expiresAt DateTime
}
model Organization {
  id String @id @default(uuid())
  name String
  type String
  active Boolean @default(true)
  users User[]
}
model Directory {
  id String @id @default(uuid())
  kind String
  name String
  minAge Int?
  maxAge Int?
  active Boolean @default(true)
  municipalities User[] @relation("Municipality")
  ranks User[] @relation("Rank")
  judgeCategories User[] @relation("JudgeCategory")
  competitionsDiscipline Competition[] @relation("Discipline")
  competitionsType Competition[] @relation("CompetitionType")
  competitionsAge Competition[] @relation("AgeGroup")
  coachLinks CoachLink[]
  assignments Assignment[]
  @@index([kind, active])
}
model CoachLink {
  id String @id @default(uuid())
  coachId String
  coach User @relation("Coach", fields: [coachId], references: [id])
  athleteId String
  athlete User @relation("Athlete", fields: [athleteId], references: [id])
  disciplineId String
  discipline Directory @relation(fields: [disciplineId], references: [id])
  status LinkStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([coachId, athleteId, disciplineId])
}
model Competition {
  id String @id @default(uuid())
  title String
  description String @default("")
  disciplineId String
  discipline Directory @relation("Discipline", fields: [disciplineId], references: [id])
  typeId String
  type Directory @relation("CompetitionType", fields: [typeId], references: [id])
  ageGroupId String
  ageGroup Directory @relation("AgeGroup", fields: [ageGroupId], references: [id])
  startsAt DateTime
  endsAt DateTime
  deadline DateTime
  location String
  format String
  level String
  calendarPlan String @default("")
  calendarNumber String @default("")
  status CompetitionStatus @default(DRAFT)
  protocolVersion Int @default(0)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  applications Application[]
  assignments Assignment[]
  files StoredFile[]
  @@index([status, startsAt])
}
model Application {
  id String @id @default(uuid())
  competitionId String
  competition Competition @relation(fields: [competitionId], references: [id])
  athleteId String
  athlete User @relation(fields: [athleteId], references: [id])
  submittedBy String
  status ApplicationStatus @default(PENDING)
  reason String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  result Result?
  @@unique([competitionId, athleteId])
}
model Assignment {
  id String @id @default(uuid())
  competitionId String
  competition Competition @relation(fields: [competitionId], references: [id])
  judgeId String
  judge User @relation(fields: [judgeId], references: [id])
  positionId String
  position Directory @relation(fields: [positionId], references: [id])
  @@unique([competitionId, judgeId])
}
model Result {
  id String @id @default(uuid())
  applicationId String @unique
  application Application @relation(fields: [applicationId], references: [id])
  outcome Outcome
  place Int?
  points Float?
}
model StoredFile {
  id String @id @default(uuid())
  competitionId String
  competition Competition @relation(fields: [competitionId], references: [id])
  name String
  storageName String @unique
  mimeType String
  size Int
  createdAt DateTime @default(now())
}
model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  role Role
  title String
  body String
  href String
  event String
  dedupeKey String @unique
  readAt DateTime?
  createdAt DateTime @default(now())
  deliveries OutgoingDelivery[]
  @@index([userId, role, createdAt])
}
model OutgoingDelivery {
  id String @id @default(uuid())
  notificationId String
  notification Notification @relation(fields: [notificationId], references: [id])
  channel String @default("TELEGRAM")
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  deliveredAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(uuid())
  actorId String?
  actor User? @relation(fields: [actorId], references: [id])
  role Role?
  action String
  entityType String
  entityId String
  details Json?
  createdAt DateTime @default(now())
}

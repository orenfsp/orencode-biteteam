# Один origin для всего: браузер ходит только на этот nginx.
# Статика отдаётся отсюда, /api/* проксируется в backend → CORS не нужен.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;

    gzip on;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml;

    # ---- API ----
    location ^~ /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;          # генерация PDF/DOCX/XLSX
    }

    # Swagger и health бэка (удобно для отладки; при желании удалите)
    location = /health        { proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}; }
    location = /docs          { proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}; }
    location = /redoc         { proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}; }
    location = /openapi.json  { proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}; }

    # QR-коды в сертификатах ведут на /verify/<номер> — отдаём красивую страницу фронта
    # (фронт использует hash-роутинг, поэтому редиректим на /#/verify/<номер>)
    location ~ ^/verify/(.+)$ {
        return 302 /#/verify/$1;
    }

    # ---- Статика ----
    location = /config.js {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(png|svg|css|js)$ {
        add_header Cache-Control "no-cache";   # без сборки/хешей — всегда ревалидируем
        try_files $uri =404;
    }
}
